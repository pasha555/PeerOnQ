<Project>
  <PropertyGroup>
    <_PeerOnQSipsorceryNoticePlatform Condition="'$(TargetFramework)' != ''">$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)'))</_PeerOnQSipsorceryNoticePlatform>
  </PropertyGroup>
  <!-- Only the final application adds these files. Android evaluates its app as
       a library; referenced libraries must not contribute duplicate paths. -->
  <ItemGroup Condition="'$(OutputType)' == 'Exe' or '$(OutputType)' == 'WinExe' or ('$(_PeerOnQSipsorceryNoticePlatform)' == 'android' and '$(AndroidApplication)' == 'true')">
    <_PeerOnQSipsorceryNoticeSource Include="$(MSBuildThisFileDirectory)../LICENSE.md">
      <NoticePath>ThirdParty/SIPSorcery/LICENSE.md</NoticePath>
    </_PeerOnQSipsorceryNoticeSource>
    <_PeerOnQSipsorceryNoticeSource Include="$(MSBuildThisFileDirectory)../_PeerOnQ/upstream.json">
      <NoticePath>ThirdParty/SIPSorcery/_PeerOnQ/upstream.json</NoticePath>
    </_PeerOnQSipsorceryNoticeSource>
    <_PeerOnQSipsorceryNoticeSource Include="$(MSBuildThisFileDirectory)../_PeerOnQ/provenance.json">
      <NoticePath>ThirdParty/SIPSorcery/_PeerOnQ/provenance.json</NoticePath>
    </_PeerOnQSipsorceryNoticeSource>
    <!-- Every PeerOnQ change to the upstream source ships beside the license. -->
    <_PeerOnQSipsorceryPatchNotice Include="$(MSBuildThisFileDirectory)../_PeerOnQ/*.patch" />
    <_PeerOnQSipsorceryAddedNotice Include="$(MSBuildThisFileDirectory)../_PeerOnQ/added/*.cs" />
    <_PeerOnQSipsorceryNoticeSource Include="@(_PeerOnQSipsorceryPatchNotice)">
      <NoticePath>ThirdParty/SIPSorcery/_PeerOnQ/%(Filename)%(Extension)</NoticePath>
    </_PeerOnQSipsorceryNoticeSource>
    <_PeerOnQSipsorceryNoticeSource Include="@(_PeerOnQSipsorceryAddedNotice)">
      <NoticePath>ThirdParty/SIPSorcery/_PeerOnQ/added/%(Filename)%(Extension)</NoticePath>
    </_PeerOnQSipsorceryNoticeSource>
    <_PeerOnQSipsorceryNotice Include="@(_PeerOnQSipsorceryNoticeSource)">
      <Link>%(NoticePath)</Link>
      <TargetPath>%(NoticePath)</TargetPath>
      <LogicalName>%(NoticePath)</LogicalName>
    </_PeerOnQSipsorceryNotice>
  </ItemGroup>
  <ItemGroup Condition="'$(_PeerOnQSipsorceryNoticePlatform)' != 'android' and '$(_PeerOnQSipsorceryNoticePlatform)' != 'ios' and '$(_PeerOnQSipsorceryNoticePlatform)' != 'maccatalyst'">
    <Content Include="@(_PeerOnQSipsorceryNotice)">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
      <CopyToPublishDirectory>Always</CopyToPublishDirectory>
      <Visible>false</Visible>
    </Content>
  </ItemGroup>
  <ItemGroup Condition="'$(_PeerOnQSipsorceryNoticePlatform)' == 'android'">
    <AndroidAsset Include="@(_PeerOnQSipsorceryNotice)">
    </AndroidAsset>
  </ItemGroup>
  <ItemGroup Condition="'$(_PeerOnQSipsorceryNoticePlatform)' == 'ios' or '$(_PeerOnQSipsorceryNoticePlatform)' == 'maccatalyst'">
    <BundleResource Include="@(_PeerOnQSipsorceryNotice)">
    </BundleResource>
  </ItemGroup>
  <Target Name="ValidatePeerOnQSipsorceryNotices" BeforeTargets="PrepareForBuild;ComputeFilesToPublish"
          Condition="'$(OutputType)' == 'Exe' or '$(OutputType)' == 'WinExe' or ('$(_PeerOnQSipsorceryNoticePlatform)' == 'android' and '$(AndroidApplication)' == 'true')">
    <Error Condition="!Exists('%(_PeerOnQSipsorceryNotice.Identity)')"
           Text="The maintained SIPSorcery package is missing an immutable license/provenance file: %(_PeerOnQSipsorceryNotice.NoticePath)" />
    <Error Condition="'@(_PeerOnQSipsorceryPatchNotice)' == ''"
           Text="The maintained SIPSorcery package does not carry its source patches." />
  </Target>
</Project>
