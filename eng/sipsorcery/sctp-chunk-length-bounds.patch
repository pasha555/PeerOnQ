+        /// <summary>
+        /// Gets the smallest Chunk Length a recognised chunk type can declare and still hold the
+        /// fixed fields its parser reads, see RFC 9260 section 3.3.
+        /// </summary>
+        private static int GetMinimumChunkLength(SctpChunkType chunkType)
+        {
+            switch (chunkType)
+            {
+                case SctpChunkType.DATA:
+                    return SCTP_CHUNK_HEADER_LENGTH + SctpDataChunk.FIXED_PARAMETERS_LENGTH;
+                case SctpChunkType.SACK:
+                    return SCTP_CHUNK_HEADER_LENGTH + SctpSackChunk.FIXED_PARAMETERS_LENGTH;
+                case SctpChunkType.INIT:
+                case SctpChunkType.INIT_ACK:
+                    return SCTP_CHUNK_HEADER_LENGTH + SctpInitChunk.FIXED_PARAMETERS_LENGTH;
+                case SctpChunkType.SHUTDOWN:
+                    return SCTP_CHUNK_HEADER_LENGTH + SctpShutdownChunk.FIXED_PARAMETERS_LENGTH;
+                default:
+                    return SCTP_CHUNK_HEADER_LENGTH;
+            }
+        }
