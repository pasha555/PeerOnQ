+        /// <summary>
+        /// Runs a blocking operation on a dedicated background thread and returns a task for its result.
+        /// </summary>
+        /// <remarks>
+        /// The DTLS handshake is fully synchronous and blocks while it waits for each flight, up to the handshake
+        /// timeout. On a thread pool worker a few remote peers that complete ICE and then send no or slow DTLS would
+        /// starve the pool. The thread ends when the operation returns; closing the peer connection closes the DTLS
+        /// transport, which ends a pending handshake. Continuations do not run on the dedicated thread.
+        /// </remarks>
+        internal static Task<T> RunOnDedicatedThread<T>(Func<T> operation, string threadName)
+        {
+            var completion = new TaskCompletionSource<T>(TaskCreationOptions.RunContinuationsAsynchronously);
+            var thread = new Thread(() =>
+            {
+                try
+                {
+                    completion.TrySetResult(operation());
+                }
+                catch (Exception excp)
+                {
+                    completion.TrySetException(excp);
+                }
+            })
+            {
+                IsBackground = true,
+                Name = threadName
+            };
+            thread.Start();
+            return completion.Task;
+        }
+
