+        /// <summary>
+        /// Checks that the RTCP packet starting at the offset fits in the remaining bytes. The header length field is the
+        /// packet length in 32-bit words minus one (RFC3550 6.4.1), so a truncated or inflated packet is detected before
+        /// any report parser reads beyond it.
+        /// </summary>
+        private static bool IsDeclaredLengthAvailable(byte[] packet, int offset)
+        {
+            int declaredLength = (((packet[offset + 2] << 8) | packet[offset + 3]) + 1) * 4;
+            return declaredLength <= packet.Length - offset;
