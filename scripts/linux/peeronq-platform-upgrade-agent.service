[Unit]
Description=Verify and apply queued PeerOnQ platform upgrades
After=docker.service network-online.target
Requires=docker.service
Wants=network-online.target

[Service]
Type=oneshot
User=root
Group=root
ExecStart=/usr/local/libexec/peeronq-platform-upgrade-agent
UMask=0077
TimeoutStartSec=45min
Restart=on-failure
RestartSec=30s
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
PrivateNetwork=true
ProtectSystem=strict
ProtectHome=true
ProtectHostname=true
ProtectClock=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectKernelLogs=true
ProtectControlGroups=true
ProtectProc=invisible
ProcSubset=pid
RestrictAddressFamilies=AF_UNIX
RestrictNamespaces=true
RestrictRealtime=true
RestrictSUIDSGID=true
LockPersonality=true
MemoryDenyWriteExecute=true
CapabilityBoundingSet=CAP_CHOWN CAP_DAC_OVERRIDE CAP_FOWNER
AmbientCapabilities=
ReadWritePaths=/opt/peeronq /var/lib/peeronq/platform-upgrade /var/log/peeronq /run/lock /etc/peeronq /usr/local/libexec /etc/systemd/system
