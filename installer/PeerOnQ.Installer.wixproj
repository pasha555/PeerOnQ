<Project Sdk="WixToolset.Sdk/6.0.1">
  <PropertyGroup>
    <OutputType>Package</OutputType>
    <Platform Condition="'$(Platform)' == ''">x64</Platform>
    <InstallerPlatform Condition="'$(InstallerPlatform)' == ''">$(Platform)</InstallerPlatform>
    <ProductVersion Condition="'$(ProductVersion)' == ''">$(PeerOnQWindowsClientVersion)</ProductVersion>
    <PublishDir Condition="'$(PublishDir)' == ''">$(MSBuildThisFileDirectory)..\dist\PeerOnQ\win-$(InstallerPlatform)</PublishDir>
    <OutputName>PeerOnQ-$(ProductVersion)-$(InstallerPlatform)</OutputName>
    <ProductCode Condition="'$(ProductCode)' == ''">*</ProductCode>
    <DefineConstants>ProductVersion=$(ProductVersion);ProductCode=$(ProductCode)</DefineConstants>
    <!-- ICE03 uses an older locale table than the Windows App SDK. The post-build target
         neutralizes only the affected SDK rows, then runs ICE03 again against the final MSI. -->
    <SuppressIces>ICE03</SuppressIces>
  </PropertyGroup>

  <ItemGroup>
    <BindPath Include="$(PublishDir)" BindName="Publish" />
    <PackageReference Include="WixToolset.UI.wixext" />
  </ItemGroup>

  <Target Name="ValidateCanonicalClientVersion" BeforeTargets="PrepareForBuild">
    <Error Condition="'$(PeerOnQWindowsClientVersion)' == '' or '$(ProductVersion)' != '$(PeerOnQWindowsClientVersion)'"
           Text="Installer ProductVersion must match the canonical PeerOnQWindowsClientVersion." />
  </Target>

  <Target Name="NormalizeWindowsAppSdkMsiLanguageMetadata" AfterTargets="Build">
    <Exec Command="powershell.exe -NoProfile -ExecutionPolicy Bypass -File &quot;$(MSBuildThisFileDirectory)..\scripts\windows\normalize-windows-app-sdk-msi-language.ps1&quot; -MsiPath &quot;$(TargetPath)&quot;" />
  </Target>
</Project>
