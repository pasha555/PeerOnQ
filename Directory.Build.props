<Project>

  <PropertyGroup>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
    <EnforceCodeStyleInBuild>false</EnforceCodeStyleInBuild>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <InvariantGlobalization>true</InvariantGlobalization>
    <Product>PeerOnQ</Product>
    <Company>PeerOnQ</Company>
    <!-- Single source of truth for server bundles and every distributable client surface. -->
    <PeerOnQWindowsClientVersion>0.9.70</PeerOnQWindowsClientVersion>
    <!-- Linux preview builds share the product source version but retain an independent release gate. -->
    <PeerOnQLinuxClientVersion>$(PeerOnQWindowsClientVersion)</PeerOnQLinuxClientVersion>
    <!-- Android preview builds share the source version and use a monotonic Play-compatible code. -->
    <PeerOnQAndroidClientVersion>$(PeerOnQWindowsClientVersion)</PeerOnQAndroidClientVersion>
    <PeerOnQAndroidClientVersionCode>9070</PeerOnQAndroidClientVersionCode>
    <!-- Apple source previews share the source version and use one monotonic App Store bundle code. -->
    <PeerOnQAppleClientVersion>$(PeerOnQWindowsClientVersion)</PeerOnQAppleClientVersion>
    <PeerOnQAppleClientVersionCode>9070</PeerOnQAppleClientVersionCode>
  </PropertyGroup>

</Project>
