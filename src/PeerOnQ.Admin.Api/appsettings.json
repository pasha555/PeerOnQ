{
  "AllowedHosts": "localhost",
  "Region": {
    "Id": "local"
  },
  "CloudWorkers": {
    "EnablePresenceExpiration": false,
    "EnableSessionReconciliation": false,
    "EnableRetention": false
  },
  "PeerOnQ": {
    "AdminTokens": {
      "Issuer": "https://admin-api-dev.peeronq.com",
      "Audience": "peeronq-admin",
      "AccessTokenMinutes": 5,
      "RefreshTokenHours": 8,
      "MfaChallengeMinutes": 5,
      "MaxFailedAttempts": 5,
      "LockoutMinutes": 15,
      "AllowMfaBypassForDevelopment": false
    },
    "AdminInfrastructureMetrics": {
      "AllowedHosts": [],
      "TimeoutSeconds": 3,
      "CacheSeconds": 10
    },
    "AlertIngestion": {
      "AllowedRunbookHosts": [
        "docs.peeronq.com"
      ],
      "MaximumAlertsPerWebhook": 100
    }
  }
}
