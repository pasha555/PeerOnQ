<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows10.0.22621.0</TargetFramework>
    <SupportedOSPlatformVersion>10.0.19041.0</SupportedOSPlatformVersion>
    <AssemblyName>PeerOnQ.SessionBroker</AssemblyName>
    <Version>$(PeerOnQWindowsClientVersion)</Version>
    <AssemblyVersion>$(PeerOnQWindowsClientVersion).0</AssemblyVersion>
    <FileVersion>$(PeerOnQWindowsClientVersion).0</FileVersion>
    <PublishSingleFile>false</PublishSingleFile>
    <!-- This Win32-only broker needs no WinRT projection. Trim its private self-contained
         runtime; never share dependencies from the configurable interactive-app directory. -->
    <IncludeWindowsSDKRefFrameworkReferences>false</IncludeWindowsSDKRefFrameworkReferences>
    <PublishTrimmed>true</PublishTrimmed>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <ILLinkTreatWarningsAsErrors>true</ILLinkTreatWarningsAsErrors>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Hosting" />
    <PackageReference Include="Microsoft.Extensions.Hosting.WindowsServices" />
    <ProjectReference Include="..\PeerOnQ.Shared.Contracts\PeerOnQ.Shared.Contracts.csproj" />
  </ItemGroup>
  <Target Name="ValidateCanonicalServiceVersion" BeforeTargets="PrepareForBuild">
    <Error Condition="'$(Version)' != '$(PeerOnQWindowsClientVersion)'"
           Text="The session broker version must match the canonical Windows client version." />
  </Target>
</Project>
