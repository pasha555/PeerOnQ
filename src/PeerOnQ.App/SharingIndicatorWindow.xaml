<Window
    x:Class="PeerOnQ.App.SharingIndicatorWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="PeerOnQ is sharing this screen">

    <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
            BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}"
            BorderThickness="1" CornerRadius="12" Padding="12,8">
        <Grid>
            <!-- A compact, always-visible local consent signal. Click it to expose the
                 capability controls; the small end button is always directly reachable. -->
            <Grid x:Name="CompactPanel" ColumnDefinitions="Auto,*,Auto" ColumnSpacing="8">
                <FontIcon Grid.Column="0" Glyph="&#xE7B3;" FontSize="16"
                          Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                          VerticalAlignment="Center" />
                <Button x:Name="ExpandButton" Grid.Column="1" Click="OnExpand" Padding="0"
                        Background="{x:Null}" BorderThickness="0" HorizontalAlignment="Stretch"
                        AutomationProperties.Name="Show sharing session details"
                        ToolTipService.ToolTip="Show sharing session details">
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                        <TextBlock x:Name="ViewerText" MaxWidth="190" TextTrimming="CharacterEllipsis"
                                   FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center"
                                   AutomationProperties.LiveSetting="Polite" />
                        <TextBlock x:Name="DurationText" Grid.Column="1" FontSize="12"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                   VerticalAlignment="Center" AutomationProperties.Name="Session duration" />
                    </Grid>
                </Button>
                <Button x:Name="CompactStopButton" Grid.Column="2" Click="OnStop" Width="32" Height="32"
                        Padding="0" VerticalAlignment="Center" AutomationProperties.Name="End sharing session"
                        ToolTipService.ToolTip="End session">
                    <FontIcon Glyph="&#xE711;" />
                </Button>
            </Grid>

            <Grid x:Name="ExpandedPanel" Visibility="Collapsed"
                  ColumnDefinitions="Auto,*,Auto,Auto,Auto,Auto" ColumnSpacing="12">
                <FontIcon Grid.Column="0" Glyph="&#xE7B3;" FontSize="16"
                          Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                          VerticalAlignment="Center" />
                <TextBlock x:Name="DetailViewerText" Grid.Column="1" MaxWidth="280"
                           TextTrimming="CharacterEllipsis" FontSize="13" FontWeight="SemiBold"
                           VerticalAlignment="Center" AutomationProperties.LiveSetting="Polite" />
                <TextBlock x:Name="DetailDurationText" Grid.Column="2" FontSize="12"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                           VerticalAlignment="Center" AutomationProperties.Name="Session duration" />
                <Button x:Name="RevokeButton" Grid.Column="3" Content="Revoke control"
                        Click="OnRevoke" VerticalAlignment="Center" />
                <Button x:Name="StopButton" Grid.Column="4" Content="End session"
                        Click="OnStop" VerticalAlignment="Center" />
                <Button x:Name="CollapseButton" Grid.Column="5" Click="OnCollapse" Width="32" Height="32"
                        Padding="0" VerticalAlignment="Center" AutomationProperties.Name="Hide sharing session details"
                        ToolTipService.ToolTip="Hide sharing session details">
                    <FontIcon Glyph="&#xE70D;" />
                </Button>
            </Grid>
        </Grid>
    </Border>
</Window>
