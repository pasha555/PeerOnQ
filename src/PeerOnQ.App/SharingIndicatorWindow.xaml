<Window
    x:Class="PeerOnQ.App.SharingIndicatorWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="PeerOnQ is sharing this screen">

    <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
            BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}"
            BorderThickness="1" CornerRadius="12" Padding="12,8">
        <Grid>
            <!-- A compact, always-visible local consent signal. Click it to expose the
                 capability controls; the small end button is always directly reachable. -->
            <Grid x:Name="CompactPanel" ColumnDefinitions="Auto,*,Auto" ColumnSpacing="8">
                <FontIcon Grid.Column="0" Glyph="&#xE7B3;" FontSize="16"
                          Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                          VerticalAlignment="Center" />
                <Button x:Name="ExpandButton" Grid.Column="1" Click="OnExpand" Padding="0"
                        Background="{x:Null}" BorderThickness="0" HorizontalAlignment="Stretch"
                        AutomationProperties.Name="Show sharing session details"
                        ToolTipService.ToolTip="Show sharing session details">
                    <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8">
                        <TextBlock x:Name="ViewerText" MaxWidth="170" TextTrimming="CharacterEllipsis"
                                   FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center"
                                   AutomationProperties.LiveSetting="Polite" />
                        <TextBlock x:Name="DurationText" Grid.Column="1" FontSize="12"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                   VerticalAlignment="Center" AutomationProperties.Name="Session duration" />
                        <!-- Sound or voice is active in this session. -->
                        <FontIcon x:Name="CompactAudioIcon" Grid.Column="2" Glyph="&#xE767;" FontSize="14"
                                  Visibility="Collapsed" VerticalAlignment="Center"
                                  Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                                  AutomationProperties.Name="Sound or voice is active" />
                    </Grid>
                </Button>
                <Button x:Name="CompactStopButton" Grid.Column="2" Click="OnStop" Width="32" Height="32"
                        Padding="0" VerticalAlignment="Center" AutomationProperties.Name="End sharing session"
                        ToolTipService.ToolTip="End session">
                    <FontIcon Glyph="&#xE711;" />
                </Button>
            </Grid>

            <Grid x:Name="ExpandedPanel" Visibility="Collapsed"
                  ColumnDefinitions="Auto,*,Auto,Auto,Auto,Auto,Auto" ColumnSpacing="12">
                <FontIcon Grid.Column="0" Glyph="&#xE7B3;" FontSize="16"
                          Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                          VerticalAlignment="Center" />
                <TextBlock x:Name="DetailViewerText" Grid.Column="1" MaxWidth="280"
                           TextTrimming="CharacterEllipsis" FontSize="13" FontWeight="SemiBold"
                           VerticalAlignment="Center" AutomationProperties.LiveSetting="Polite" />
                <TextBlock x:Name="DetailDurationText" Grid.Column="2" FontSize="12"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                           VerticalAlignment="Center" AutomationProperties.Name="Session duration" />
                <StackPanel Grid.Column="3" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                    <TextBlock x:Name="AudioStatusText" FontSize="12" VerticalAlignment="Center" MaxWidth="200"
                               TextTrimming="CharacterEllipsis" Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                               AutomationProperties.LiveSetting="Polite" AutomationProperties.Name="Sound and voice status" />
                    <!-- Local opt-in only: this machine's microphone opens solely from this toggle. -->
                    <ToggleButton x:Name="VoiceToggle" Visibility="Collapsed"
                                  Click="OnVoiceToggled" VerticalAlignment="Center"
                                  AutomationProperties.Name="Turn this computer's microphone on or off"
                                  ToolTipService.ToolTip="Talk with the viewer. Your microphone stays off until you turn it on; you hear the viewer automatically.">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <FontIcon Glyph="&#xE720;" FontSize="14" />
                            <TextBlock Text="Microphone" />
                        </StackPanel>
                    </ToggleButton>
                </StackPanel>
                <Button x:Name="RevokeButton" Grid.Column="4" Content="Revoke control"
                        Click="OnRevoke" VerticalAlignment="Center" />
                <Button x:Name="StopButton" Grid.Column="5" Content="End session"
                        Click="OnStop" VerticalAlignment="Center" />
                <Button x:Name="CollapseButton" Grid.Column="6" Click="OnCollapse" Width="32" Height="32"
                        Padding="0" VerticalAlignment="Center" AutomationProperties.Name="Hide sharing session details"
                        ToolTipService.ToolTip="Hide sharing session details">
                    <FontIcon Glyph="&#xE70D;" />
                </Button>
            </Grid>
        </Grid>
    </Border>
</Window>
