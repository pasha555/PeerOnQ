<Application
    x:Class="PeerOnQ.App.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.ThemeDictionaries>
                <ResourceDictionary x:Key="Light">
                    <SolidColorBrush x:Key="PeerOnQPageBrush" Color="#F8FAF9" />
                    <SolidColorBrush x:Key="PeerOnQSurfaceBrush" Color="#FFFFFF" />
                    <SolidColorBrush x:Key="PeerOnQBorderBrush" Color="#E2E8E5" />
                    <SolidColorBrush x:Key="PeerOnQSubtleBrush" Color="#F0F4F2" />
                    <SolidColorBrush x:Key="PeerOnQMutedTextBrush" Color="#66756E" />
                    <SolidColorBrush x:Key="PeerOnQAccentBrush" Color="#198754" />
                    <SolidColorBrush x:Key="PeerOnQAccentHoverBrush" Color="#146C43" />
                    <SolidColorBrush x:Key="PeerOnQAccentTextBrush" Color="#FFFFFF" />
                    <SolidColorBrush x:Key="PeerOnQSuccessSubtleBrush" Color="#EAF7F1" />
                    <SolidColorBrush x:Key="PeerOnQSuccessBorderBrush" Color="#B8E1CE" />
                    <SolidColorBrush x:Key="PeerOnQTrustBrush" Color="#0F2E46" />
                    <SolidColorBrush x:Key="PeerOnQTrustSubtleBrush" Color="#EAF2F7" />
                    <SolidColorBrush x:Key="PeerOnQTrustBorderBrush" Color="#C6D9E5" />
                    <SolidColorBrush x:Key="AccentFillColorDefaultBrush" Color="#198754" />
                    <SolidColorBrush x:Key="AccentFillColorSecondaryBrush" Color="#2D9968" />
                    <SolidColorBrush x:Key="AccentFillColorTertiaryBrush" Color="#6DBA96" />
                    <SolidColorBrush x:Key="AccentTextFillColorPrimaryBrush" Color="#146C43" />
                    <SolidColorBrush x:Key="NavigationViewItemBackgroundSelected" Color="#198754" />
                    <SolidColorBrush x:Key="NavigationViewItemBackgroundSelectedPointerOver" Color="#146C43" />
                    <SolidColorBrush x:Key="NavigationViewItemBackgroundSelectedPressed" Color="#105936" />
                    <SolidColorBrush x:Key="NavigationViewItemForegroundSelected" Color="#FFFFFF" />
                    <SolidColorBrush x:Key="NavigationViewItemForegroundSelectedPointerOver" Color="#FFFFFF" />
                    <SolidColorBrush x:Key="NavigationViewItemForegroundSelectedPressed" Color="#FFFFFF" />
                </ResourceDictionary>
                <ResourceDictionary x:Key="Dark">
                    <SolidColorBrush x:Key="PeerOnQPageBrush" Color="#101713" />
                    <SolidColorBrush x:Key="PeerOnQSurfaceBrush" Color="#17201B" />
                    <SolidColorBrush x:Key="PeerOnQBorderBrush" Color="#2C3932" />
                    <SolidColorBrush x:Key="PeerOnQSubtleBrush" Color="#223028" />
                    <SolidColorBrush x:Key="PeerOnQMutedTextBrush" Color="#A7B6AE" />
                    <SolidColorBrush x:Key="PeerOnQAccentBrush" Color="#45B984" />
                    <SolidColorBrush x:Key="PeerOnQAccentHoverBrush" Color="#5BC996" />
                    <SolidColorBrush x:Key="PeerOnQAccentTextBrush" Color="#07130D" />
                    <SolidColorBrush x:Key="PeerOnQSuccessSubtleBrush" Color="#183B2A" />
                    <SolidColorBrush x:Key="PeerOnQSuccessBorderBrush" Color="#2B6C4C" />
                    <SolidColorBrush x:Key="PeerOnQTrustBrush" Color="#8EC5E5" />
                    <SolidColorBrush x:Key="PeerOnQTrustSubtleBrush" Color="#172B37" />
                    <SolidColorBrush x:Key="PeerOnQTrustBorderBrush" Color="#315166" />
                    <SolidColorBrush x:Key="AccentFillColorDefaultBrush" Color="#45B984" />
                    <SolidColorBrush x:Key="AccentFillColorSecondaryBrush" Color="#5BC996" />
                    <SolidColorBrush x:Key="AccentFillColorTertiaryBrush" Color="#78D5AA" />
                    <SolidColorBrush x:Key="AccentTextFillColorPrimaryBrush" Color="#5BC996" />
                    <SolidColorBrush x:Key="NavigationViewItemBackgroundSelected" Color="#45B984" />
                    <SolidColorBrush x:Key="NavigationViewItemBackgroundSelectedPointerOver" Color="#5BC996" />
                    <SolidColorBrush x:Key="NavigationViewItemBackgroundSelectedPressed" Color="#78D5AA" />
                    <SolidColorBrush x:Key="NavigationViewItemForegroundSelected" Color="#07130D" />
                    <SolidColorBrush x:Key="NavigationViewItemForegroundSelectedPointerOver" Color="#07130D" />
                    <SolidColorBrush x:Key="NavigationViewItemForegroundSelectedPressed" Color="#07130D" />
                </ResourceDictionary>
                <ResourceDictionary x:Key="HighContrast">
                    <SolidColorBrush x:Key="PeerOnQPageBrush" Color="{ThemeResource SystemColorWindowColor}" />
                    <SolidColorBrush x:Key="PeerOnQSurfaceBrush" Color="{ThemeResource SystemColorWindowColor}" />
                    <SolidColorBrush x:Key="PeerOnQBorderBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
                    <SolidColorBrush x:Key="PeerOnQSubtleBrush" Color="{ThemeResource SystemColorButtonFaceColor}" />
                    <SolidColorBrush x:Key="PeerOnQMutedTextBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
                    <SolidColorBrush x:Key="PeerOnQAccentBrush" Color="{ThemeResource SystemColorHighlightColor}" />
                    <SolidColorBrush x:Key="PeerOnQAccentHoverBrush" Color="{ThemeResource SystemColorHighlightColor}" />
                    <SolidColorBrush x:Key="PeerOnQAccentTextBrush" Color="{ThemeResource SystemColorHighlightTextColor}" />
                    <SolidColorBrush x:Key="PeerOnQSuccessSubtleBrush" Color="{ThemeResource SystemColorWindowColor}" />
                    <SolidColorBrush x:Key="PeerOnQSuccessBorderBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
                    <SolidColorBrush x:Key="PeerOnQTrustBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
                    <SolidColorBrush x:Key="PeerOnQTrustSubtleBrush" Color="{ThemeResource SystemColorWindowColor}" />
                    <SolidColorBrush x:Key="PeerOnQTrustBorderBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
                </ResourceDictionary>
            </ResourceDictionary.ThemeDictionaries>
            <ResourceDictionary.MergedDictionaries>
                <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls" />
            </ResourceDictionary.MergedDictionaries>
            <Color x:Key="SystemAccentColor">#198754</Color>
            <SolidColorBrush x:Key="SystemControlHighlightAccentBrush" Color="#198754" />
            <SolidColorBrush x:Key="AccentFillColorDefaultBrush" Color="#198754" />
            <SolidColorBrush x:Key="AccentFillColorSecondaryBrush" Color="#2D9968" />
            <SolidColorBrush x:Key="AccentFillColorTertiaryBrush" Color="#6DBA96" />
            <SolidColorBrush x:Key="AccentTextFillColorPrimaryBrush" Color="#146C43" />
            <SolidColorBrush x:Key="AccentButtonBackground" Color="#198754" />
            <SolidColorBrush x:Key="AccentButtonBackgroundPointerOver" Color="#146C43" />
            <SolidColorBrush x:Key="AccentButtonBackgroundPressed" Color="#105936" />
            <SolidColorBrush x:Key="AccentButtonForeground" Color="#FFFFFF" />
            <SolidColorBrush x:Key="AccentButtonForegroundPointerOver" Color="#FFFFFF" />
            <SolidColorBrush x:Key="AccentButtonForegroundPressed" Color="#FFFFFF" />
            <SolidColorBrush x:Key="TextControlBorderBrushFocused" Color="#198754" />
            <SolidColorBrush x:Key="TextControlElevationBorderFocusedBrush" Color="#198754" />
            <SolidColorBrush x:Key="ToggleButtonBackgroundChecked" Color="#198754" />
            <SolidColorBrush x:Key="ToggleButtonBackgroundCheckedPointerOver" Color="#146C43" />
            <SolidColorBrush x:Key="ToggleButtonBackgroundCheckedPressed" Color="#105936" />
            <SolidColorBrush x:Key="ToggleButtonForegroundChecked" Color="#FFFFFF" />
            <SolidColorBrush x:Key="ToggleButtonForegroundCheckedPointerOver" Color="#FFFFFF" />
            <SolidColorBrush x:Key="ToggleButtonForegroundCheckedPressed" Color="#FFFFFF" />
            <SolidColorBrush x:Key="NavigationViewSelectionIndicatorForeground" Color="#198754" />
            <SolidColorBrush x:Key="NavigationViewItemBackgroundSelected" Color="#198754" />
            <SolidColorBrush x:Key="NavigationViewItemBackgroundSelectedPointerOver" Color="#146C43" />
            <SolidColorBrush x:Key="NavigationViewItemBackgroundSelectedPressed" Color="#105936" />
            <SolidColorBrush x:Key="NavigationViewItemForegroundSelected" Color="#FFFFFF" />
            <SolidColorBrush x:Key="NavigationViewItemForegroundSelectedPointerOver" Color="#FFFFFF" />
            <SolidColorBrush x:Key="NavigationViewItemForegroundSelectedPressed" Color="#FFFFFF" />
            <SolidColorBrush x:Key="CheckBoxBackgroundChecked" Color="#198754" />
            <SolidColorBrush x:Key="CheckBoxBackgroundCheckedPointerOver" Color="#146C43" />
            <SolidColorBrush x:Key="CheckBoxBackgroundCheckedPressed" Color="#105936" />
            <SolidColorBrush x:Key="CheckBoxBorderBrushChecked" Color="#198754" />
            <SolidColorBrush x:Key="CheckBoxBorderBrushCheckedPointerOver" Color="#146C43" />
            <SolidColorBrush x:Key="CheckBoxBorderBrushCheckedPressed" Color="#105936" />
            <SolidColorBrush x:Key="CheckBoxCheckGlyphForegroundChecked" Color="#FFFFFF" />
            <SolidColorBrush x:Key="ToggleSwitchFillOn" Color="#198754" />
            <SolidColorBrush x:Key="ToggleSwitchFillOnPointerOver" Color="#146C43" />
            <SolidColorBrush x:Key="ToggleSwitchFillOnPressed" Color="#105936" />
            <SolidColorBrush x:Key="RemoteCanvasBackgroundBrush" Color="#101010" />
            <Style x:Key="PeerOnQCardStyle" TargetType="Border">
                <Setter Property="Background" Value="{ThemeResource PeerOnQSurfaceBrush}" />
                <Setter Property="BorderBrush" Value="{ThemeResource PeerOnQBorderBrush}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="CornerRadius" Value="10" />
                <Setter Property="Padding" Value="20" />
            </Style>
            <Style x:Key="PeerOnQPageTitleStyle" TargetType="TextBlock">
                <Setter Property="FontSize" Value="28" />
                <Setter Property="FontWeight" Value="SemiBold" />
            </Style>
            <Style x:Key="PeerOnQSectionTitleStyle" TargetType="TextBlock">
                <Setter Property="FontSize" Value="18" />
                <Setter Property="FontWeight" Value="SemiBold" />
            </Style>
            <Style x:Key="PeerOnQModeButtonStyle" TargetType="ToggleButton">
                <Setter Property="MinHeight" Value="66" />
                <Setter Property="HorizontalAlignment" Value="Stretch" />
                <Setter Property="HorizontalContentAlignment" Value="Center" />
                <Setter Property="VerticalContentAlignment" Value="Center" />
                <Setter Property="Padding" Value="14,10" />
                <Setter Property="CornerRadius" Value="10" />
            </Style>
            <Style x:Key="PeerOnQPrimaryButtonStyle" TargetType="Button">
                <Setter Property="Background" Value="{ThemeResource PeerOnQAccentBrush}" />
                <Setter Property="Foreground" Value="{ThemeResource PeerOnQAccentTextBrush}" />
                <Setter Property="MinHeight" Value="42" />
                <Setter Property="MinWidth" Value="104" />
                <Setter Property="Padding" Value="20,10" />
                <Setter Property="CornerRadius" Value="10" />
                <Setter Property="HorizontalContentAlignment" Value="Center" />
                <Setter Property="VerticalContentAlignment" Value="Center" />
            </Style>
            <Style x:Key="PeerOnQDialogPrimaryButtonStyle" TargetType="Button">
                <Setter Property="Background" Value="{ThemeResource PeerOnQAccentBrush}" />
                <Setter Property="Foreground" Value="{ThemeResource PeerOnQAccentTextBrush}" />
                <Setter Property="MinHeight" Value="40" />
                <Setter Property="MinWidth" Value="120" />
                <Setter Property="Padding" Value="20,10" />
                <Setter Property="CornerRadius" Value="10" />
                <Setter Property="HorizontalContentAlignment" Value="Center" />
                <Setter Property="VerticalContentAlignment" Value="Center" />
            </Style>
        </ResourceDictionary>
    </Application.Resources>
</Application>
