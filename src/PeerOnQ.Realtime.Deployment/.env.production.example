PEERONQ_TURN_REALM=turn.example.com
PEERONQ_TURN_SERVER_ID=turn-eu-1
PEERONQ_TURN_REGION=eu-west
PEERONQ_TURN_CERT_DIR=/etc/peeronq/certs/turn.example.com
PEERONQ_TURN_SHARED_SECRET_FILE=/etc/peeronq/secrets/turn-shared-secret
