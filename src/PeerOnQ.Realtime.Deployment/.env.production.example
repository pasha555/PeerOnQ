PEERONQ_SIGNAL_PUBLIC_HOST=signal.example.com
PEERONQ_SIGNAL_CERT_DIR=/etc/peeronq/certs/signal.example.com
PEERONQ_TURN_PUBLIC_HOST=turn.example.com
