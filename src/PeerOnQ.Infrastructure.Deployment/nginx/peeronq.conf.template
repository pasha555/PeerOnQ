map $http_upgrade $connection_upgrade {
  default upgrade;
  '' close;
}

limit_req_zone $binary_remote_addr zone=admin_auth:10m rate=5r/m;
limit_req_zone $binary_remote_addr zone=public_api:10m rate=30r/s;
limit_conn_zone $binary_remote_addr zone=downloads_per_ip:10m;

# Docker service addresses can change during an in-place release. Resolve them continuously so
# this long-lived edge container never keeps routing to a replaced container's stale IP.
resolver 127.0.0.11 valid=10s ipv6=off;
resolver_timeout 5s;
upstream cloud_api { zone cloud_api 64k; least_conn; ${PEERONQ_CLOUD_API_UPSTREAMS} keepalive 32; }
upstream admin_api { zone admin_api 64k; least_conn; server admin-api:8080 resolve max_fails=2 fail_timeout=5s; keepalive 16; }
upstream presence_server { zone presence_server 64k; least_conn; ${PEERONQ_PRESENCE_UPSTREAMS} keepalive 32; }
upstream downloads_service { zone downloads_service 64k; least_conn; ${PEERONQ_DOWNLOADS_UPSTREAMS} keepalive 16; }
upstream admin_ui { zone admin_ui 64k; server admin-ui:8080 resolve; keepalive 8; }
upstream portal_ui { zone portal_ui 64k; server portal-ui:8080 resolve; keepalive 8; }
upstream web_ui { zone web_ui 64k; server web-ui:8080 resolve; keepalive 8; }
upstream signaling_server { zone signaling_server 64k; least_conn; ${PEERONQ_SIGNALING_UPSTREAMS} keepalive 32; }
upstream grafana_server { zone grafana_server 64k; server grafana:3000 resolve; keepalive 8; }
upstream prometheus_server { zone prometheus_server 64k; server prometheus:9090 resolve; keepalive 8; }

server {
  listen 80;
  server_name ${PEERONQ_WEB_HOST} ${PEERONQ_WEB_WWW_HOST} ${PEERONQ_API_HOST} ${PEERONQ_ADMIN_HOST} ${PEERONQ_PORTAL_HOST} ${PEERONQ_GRAFANA_HOST} ${PEERONQ_PROMETHEUS_HOST} ${PEERONQ_DOWNLOAD_HOST} ${PEERONQ_UPDATE_HOST} ${PEERONQ_PRESENCE_HOST} ${PEERONQ_SIGNAL_HOST};
  return 308 https://$host$request_uri;
}

server {
  listen 443 ssl;
  http2 on;
  server_name ${PEERONQ_WEB_HOST} ${PEERONQ_WEB_WWW_HOST};
  server_tokens off;
  access_log off;
  error_log /dev/stderr warn;
  ssl_certificate /certs/fullchain.pem;
  ssl_certificate_key /run/secrets/peeronq_tls_private_key;
  ssl_protocols TLSv1.2 TLSv1.3;
  ssl_session_cache shared:SSL:10m;
  ssl_session_timeout 1d;
  ssl_session_tickets off;
  add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;
  add_header X-Content-Type-Options "nosniff" always;
  add_header X-Frame-Options "DENY" always;
  add_header Referrer-Policy "strict-origin-when-cross-origin" always;
  add_header Cross-Origin-Opener-Policy "same-origin" always;
  add_header Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=(), usb=()" always;
  add_header Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src 'self'; font-src 'self'; object-src 'none'; frame-ancestors 'none'; base-uri 'self'; form-action 'self'; upgrade-insecure-requests" always;
  client_max_body_size 64k;

  location ~ (^|/)\. { return 404; }
  location = /downloads {
    add_header Cache-Control "no-store, max-age=0" always;
    root /var/lib/peeronq/website/current;
    try_files /peeronq-downloads-ui-v1.html /_peeronq/base-downloads;
  }
  location = /downloads/ {
    add_header Cache-Control "no-store, max-age=0" always;
    root /var/lib/peeronq/website/current;
    try_files /peeronq-downloads-ui-v1.html /_peeronq/base-downloads;
  }
  location = /_peeronq/base-downloads {
    internal;
    add_header Cache-Control "no-store, max-age=0" always;
    proxy_pass http://web_ui/;
    include /etc/nginx/proxy_params;
  }
  location = /downloads/PeerOnQ-Windows-x64.msi {
    proxy_buffering off;
    proxy_max_temp_file_size 0;
    proxy_read_timeout 600s;
    send_timeout 600s;
    expires off;
    add_header Cache-Control "no-store, max-age=0" always;
    proxy_pass http://web_ui;
    include /etc/nginx/proxy_params;
  }
  location = /downloads/SHA256SUMS.txt {
    add_header Cache-Control "no-store, max-age=0" always;
    proxy_pass http://web_ui;
    include /etc/nginx/proxy_params;
  }
  location = /downloads/embedded-windows-version.txt {
    add_header Cache-Control "no-store, max-age=0" always;
    proxy_pass http://web_ui;
    include /etc/nginx/proxy_params;
  }
  location = /downloads/embedded-windows-release-type.txt {
    add_header Cache-Control "no-store, max-age=0" always;
    proxy_pass http://web_ui;
    include /etc/nginx/proxy_params;
  }
  location = /downloads/UNSIGNED-PILOT-NOTICE.txt {
    add_header Cache-Control "no-store, max-age=0" always;
    proxy_pass http://web_ui;
    include /etc/nginx/proxy_params;
  }
  # Use 410 because the server-level 404 fallback intentionally serves the public SPA.
  location ^~ /downloads/ { return 410; }
  location /assets/ {
    root /var/lib/peeronq/website/current;
    try_files $uri @web_ui;
  }
  error_page 404 = @web_ui;
  location / {
    root /var/lib/peeronq/website/current;
    try_files $uri $uri/ /index.html =404;
  }
  location @web_ui { proxy_pass http://web_ui; include /etc/nginx/proxy_params; }
}

server {
  listen 443 ssl;
  http2 on;
  server_name ${PEERONQ_API_HOST};
  server_tokens off;
  access_log off;
  error_log /dev/stderr warn;
  ssl_certificate /certs/fullchain.pem;
  ssl_certificate_key /run/secrets/peeronq_tls_private_key;
  ssl_protocols TLSv1.2 TLSv1.3;
  ssl_session_cache shared:SSL:10m;
  ssl_session_timeout 1d;
  ssl_session_tickets off;
  add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;
  add_header X-Content-Type-Options "nosniff" always;
  add_header Referrer-Policy "no-referrer" always;
  client_max_body_size 2m;
  proxy_send_timeout 30s;
  proxy_read_timeout 30s;

  # Orchestrator probes must not consume the public API request budget or be rejected while
  # user traffic is intentionally shed.
  location = /health/live { proxy_pass http://cloud_api/health/live; include /etc/nginx/proxy_params; access_log off; }
  location = /health/ready { proxy_pass http://cloud_api/health/ready; include /etc/nginx/proxy_params; access_log off; }
  location = /health/startup { proxy_pass http://cloud_api/health/startup; include /etc/nginx/proxy_params; access_log off; }
  location /v1/diagnostics/uploads {
    client_max_body_size 21m;
    proxy_request_buffering off;
    proxy_read_timeout 120s;
    proxy_pass http://cloud_api;
    include /etc/nginx/proxy_params;
  }
  location / { limit_req zone=public_api burst=60 nodelay; proxy_pass http://cloud_api; include /etc/nginx/proxy_params; }
}

server {
  listen 443 ssl;
  http2 on;
  server_name ${PEERONQ_ADMIN_HOST};
  allow ${PEERONQ_ADMIN_ALLOWED_CIDR};
  deny all;
  server_tokens off;
  access_log off;
  error_log /dev/stderr warn;
  ssl_certificate /certs/fullchain.pem;
  ssl_certificate_key /run/secrets/peeronq_tls_private_key;
  ssl_protocols TLSv1.2 TLSv1.3;
  ssl_session_cache shared:SSL:10m;
  ssl_session_timeout 1d;
  ssl_session_tickets off;
  add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;
  add_header X-Content-Type-Options "nosniff" always;
  add_header X-Frame-Options "DENY" always;
  add_header Referrer-Policy "no-referrer" always;
  client_max_body_size 1m;
  proxy_send_timeout 30s;
  proxy_read_timeout 30s;

  location ~ ^/admin/v1/auth/(login|mfa/verify|refresh)$ {
    limit_req zone=admin_auth burst=5 nodelay;
    proxy_pass http://admin_api;
    include /etc/nginx/proxy_params;
  }
  location = /admin/v1/releases {
    client_max_body_size 100m;
    proxy_request_buffering off;
    proxy_send_timeout 600s;
    proxy_read_timeout 600s;
    proxy_pass http://admin_api;
    include /etc/nginx/proxy_params;
  }
  location = /admin/v1/website-releases {
    client_max_body_size 100m;
    proxy_request_buffering off;
    proxy_send_timeout 600s;
    proxy_read_timeout 600s;
    proxy_pass http://admin_api;
    include /etc/nginx/proxy_params;
  }
  location = /admin/v1/platform-upgrades/stage {
    client_max_body_size 260m;
    proxy_request_buffering off;
    proxy_send_timeout 1800s;
    proxy_read_timeout 1800s;
    proxy_pass http://admin_api;
    include /etc/nginx/proxy_params;
  }
  location /admin/v1/ { proxy_pass http://admin_api; include /etc/nginx/proxy_params; }
  location / { proxy_pass http://admin_ui; include /etc/nginx/proxy_params; }
}

