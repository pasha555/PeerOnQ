server {
  listen 443 ssl;
  http2 on;
  server_name ${PEERONQ_UPDATE_HOST};
  server_tokens off;
  access_log off;
  error_log /dev/stderr warn;
  ssl_certificate /certs/fullchain.pem;
  ssl_certificate_key /run/secrets/peeronq_tls_private_key;
  ssl_protocols TLSv1.2 TLSv1.3;
  ssl_session_cache shared:SSL:10m;
  ssl_session_timeout 1d;
  ssl_session_tickets off;
  add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;
  add_header X-Content-Type-Options "nosniff" always;
  add_header X-Frame-Options "DENY" always;
  add_header Referrer-Policy "no-referrer" always;
  root /var/lib/peeronq/releases;
  client_max_body_size 64k;

  location ~ ^/(stable|beta)/(x64|arm64)/manifest\.json$ {
    limit_except GET { deny all; }
    default_type application/json;
    add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;
    add_header X-Content-Type-Options "nosniff" always;
    add_header X-Frame-Options "DENY" always;
    add_header Referrer-Policy "no-referrer" always;
    add_header Cache-Control "no-store" always;
    try_files $uri =404;
  }

  location ~ "^/(stable|beta)/(x64|arm64)/PeerOnQ-[0-9]+(?:\.[0-9]+){2,3}-(?:x64|arm64)\.msi$" {
    limit_except GET { deny all; }
    default_type application/octet-stream;
    add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;
    add_header X-Content-Type-Options "nosniff" always;
    add_header X-Frame-Options "DENY" always;
    add_header Referrer-Policy "no-referrer" always;
    add_header Cache-Control "public, max-age=31536000, immutable" always;
    try_files $uri =404;
  }

  location / { return 404; }
}

server {
  listen 443 ssl;
  http2 on;
  server_name ${PEERONQ_DOWNLOAD_HOST};
  server_tokens off;
  access_log off;
  error_log /dev/stderr warn;
  ssl_certificate /certs/fullchain.pem;
  ssl_certificate_key /run/secrets/peeronq_tls_private_key;
  ssl_protocols TLSv1.2 TLSv1.3;
  ssl_session_cache shared:SSL:10m;
  ssl_session_timeout 1d;
  ssl_session_tickets off;
  add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;
  add_header X-Content-Type-Options "nosniff" always;
  client_max_body_size 1m;
  proxy_send_timeout 30s;
  # A cache miss is verified completely before the first response byte. Keep this just above the
  # service's bounded 30-minute stream deadline; slow clients remain bounded by send_timeout.
  proxy_read_timeout 1850s;
  send_timeout 60s;
  # Keep probes outside the download connection cap. The cap protects long-lived artifact
  # streams; applying it to readiness creates false 503s during concurrent health checks.
  location = /health/live { proxy_pass http://downloads_service/health/live; include /etc/nginx/proxy_params; access_log off; }
  location = /health/ready { proxy_pass http://downloads_service/health/ready; include /etc/nginx/proxy_params; access_log off; }
  location = /health/startup { proxy_pass http://downloads_service/health/startup; include /etc/nginx/proxy_params; access_log off; }
  location / {
    limit_req zone=public_api burst=60 nodelay;
    limit_conn downloads_per_ip 4;
    proxy_buffering off;
    proxy_max_temp_file_size 0;
    proxy_pass http://downloads_service;
    include /etc/nginx/proxy_params;
  }
}

