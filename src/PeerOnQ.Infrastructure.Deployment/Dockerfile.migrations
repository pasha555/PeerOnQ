FROM mcr.microsoft.com/dotnet/sdk:10.0.402@sha256:0d99ebf1ccad15037b5c98c9fe8979d6b8dbac23812feae2277a0b277b5c5ffa AS build
WORKDIR /src
COPY . .
RUN dotnet tool install --tool-path /tools dotnet-ef --version 10.0.13
RUN dotnet restore src/PeerOnQ.Cloud.Infrastructure/PeerOnQ.Cloud.Infrastructure.csproj --disable-parallel
RUN /tools/dotnet-ef migrations bundle \
    --project src/PeerOnQ.Cloud.Infrastructure/PeerOnQ.Cloud.Infrastructure.csproj \
    --startup-project src/PeerOnQ.Cloud.Infrastructure/PeerOnQ.Cloud.Infrastructure.csproj \
    --configuration Release \
    --output /out/peeronq-migrate \
    --force

FROM mcr.microsoft.com/dotnet/aspnet:10.0.13@sha256:d5633778c754e89a386882eddf8dbee6942447a8a4b8267c19cf1e1158d0b0ac AS final
WORKDIR /app
RUN apt-get update \
    && apt-get install --no-install-recommends -y libgssapi-krb5-2 \
    && rm -rf /var/lib/apt/lists/*
COPY --from=build --chown=$APP_UID:$APP_UID /out/peeronq-migrate ./peeronq-migrate
USER $APP_UID
ENTRYPOINT ["./peeronq-migrate"]
