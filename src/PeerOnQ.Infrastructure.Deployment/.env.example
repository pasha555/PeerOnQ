# Copy to .env outside source control. Empty values are intentional: generate or obtain them
# from the environment's secret manager before running Compose.
PEERONQ_REGION=local-dev

# Reserved development names that resolve to loopback without a hosts-file edit.
PEERONQ_API_HOST=api.dev.localhost
PEERONQ_ADMIN_HOST=admin.dev.localhost
PEERONQ_PORTAL_HOST=portal.dev.localhost
PEERONQ_GRAFANA_HOST=grafana.dev.localhost
PEERONQ_PROMETHEUS_HOST=prometheus.dev.localhost
# Nginx evaluates the direct TCP source address; production should use the server LAN CIDR.
PEERONQ_ADMIN_ALLOWED_CIDR=0.0.0.0/0
PEERONQ_DOWNLOAD_HOST=download.dev.localhost
PEERONQ_WEB_HOST=dev.localhost
PEERONQ_WEB_WWW_HOST=www.dev.localhost
PEERONQ_UPDATE_HOST=updates.dev.localhost
PEERONQ_PRESENCE_HOST=presence.dev.localhost
PEERONQ_SIGNAL_HOST=signal.dev.localhost
PEERONQ_TURN_PUBLIC_HOST=turn.dev.localhost
PEERONQ_TURN_REALM=turn.dev.localhost
PEERONQ_SIGNAL_SERVER_ID=signal-local-1
PEERONQ_SIGNALING_ATTESTATION_ISSUER=https://api.dev.localhost
PEERONQ_SIGNALING_ATTESTATION_AUDIENCE=peeronq-signaling
PEERONQ_SIGNALING_ATTESTATION_LIFETIME=00:05:00
PEERONQ_SIGNALING_ATTESTATION_MAXIMUM_LIFETIME=00:15:00
PEERONQ_SIGNALING_ATTESTATION_CLOCK_SKEW=00:00:30
PEERONQ_TURN_SERVER_ID=turn-local-1
PEERONQ_PRESENCE_SERVER_ID=presence-local-1
PEERONQ_HTTPS_PORT=8443
PEERONQ_HTTPS_BIND_ADDRESS=127.0.0.1
PEERONQ_GRAFANA_PORT=3000
PEERONQ_PROMETHEUS_PORT=9090
PEERONQ_ADMIN_PROMETHEUS_ENDPOINT=http://prometheus:9090/
PEERONQ_ADMIN_PROMETHEUS_ALLOWED_HOST=prometheus
PEERONQ_FLUENT_FORWARD_PORT=24224
PEERONQ_COTURN_FLUENT_FORWARD_PORT=24225
PEERONQ_RETENTION_POLICY_VERSION=phase6-v1
PEERONQ_AUDIT_RETENTION_DAYS=365
PEERONQ_AUDIT_RETENTION_ENABLED=false
PEERONQ_AUDIT_LEGAL_HOLD=false
PEERONQ_ALERT_RETENTION_DAYS=365
PEERONQ_ALERT_RETENTION_ENABLED=true
PEERONQ_ALERT_LEGAL_HOLD=false
PEERONQ_DIAGNOSTICS_LEGAL_HOLD=false
PEERONQ_DIAGNOSTICS_ALLOW_SINGLE_NODE_FILESYSTEM=false
PEERONQ_SESSION_RECONCILIATION_INTERVAL=00:01:00
PEERONQ_CLOUD_WORKER_LEASE_DURATION=00:02:00
PEERONQ_SESSION_NEGOTIATION_TIMEOUT=00:05:00
PEERONQ_SESSION_CONNECTED_INACTIVITY_TIMEOUT=00:03:00
PEERONQ_SESSION_RECONCILIATION_BATCH_SIZE=500
PEERONQ_TURN_BIND_ADDRESS=127.0.0.1
# Single-node Docker deployment behind NAT: use the public IPv4 address only.
PEERONQ_TURN_EXTERNAL_IP=
PEERONQ_TURN_ALLOW_PRIVATE_PEERS=true
PEERONQ_TURN_RELAY_ONLY=false
PEERONQ_RELEASE_ARTIFACT_HOST=updates.dev.localhost
PEERONQ_RELEASE_PUBLICATION_ENABLED=false
PEERONQ_RELEASE_SIGNING_KEY_ID=
PEERONQ_RELEASE_SIGNING_PUBLIC_KEY_SPKI_BASE64=
PEERONQ_RELEASE_MAXIMUM_PACKAGE_BYTES=100663296
PEERONQ_WEBSITE_PUBLICATION_ENABLED=false
PEERONQ_WEBSITE_SIGNING_KEY_ID=
PEERONQ_WEBSITE_SIGNING_PUBLIC_KEY_SPKI_BASE64=
PEERONQ_WEBSITE_MAXIMUM_ARCHIVE_BYTES=100663296
PEERONQ_WINDOWS_DOWNLOADS_AVAILABLE=false
PEERONQ_MACOS_DOWNLOAD_URL=
PEERONQ_LINUX_X64_DOWNLOAD_URL=
PEERONQ_LINUX_ARM64_DOWNLOAD_URL=
PEERONQ_ANDROID_DOWNLOAD_URL=
PEERONQ_IOS_DOWNLOAD_URL=
PEERONQ_MAXIMUM_ARTIFACT_BYTES=1073741824
PEERONQ_DOWNLOAD_MAX_CONCURRENT_STREAMS=16
PEERONQ_DOWNLOAD_STREAM_BUFFER_BYTES=131072
PEERONQ_DOWNLOAD_STREAM_DEADLINE_MINUTES=30
PEERONQ_DOWNLOAD_CACHE_MAX_BYTES=4294967296
PEERONQ_PLATFORM_UPGRADE_ENABLED=false
PEERONQ_PLATFORM_UPGRADE_MAXIMUM_BUNDLE_BYTES=268435456

# Paths must live outside the repository in staging/production.
PEERONQ_TLS_CERT_DIR=
PEERONQ_TLS_PRIVATE_KEY_FILE=
PEERONQ_ALERTMANAGER_CONFIG=
PEERONQ_ALERTMANAGER_WEBHOOK_TOKEN_FILE=
PEERONQ_POSTGRES_BACKUP_PGPASS_FILE=
PEERONQ_POSTGRES_RESTORE_PGPASS_FILE=
PEERONQ_TURN_SHARED_SECRET_FILE=
PEERONQ_TURN_CERT_DIR=
PEERONQ_ADMIN_DATA_PROTECTION_CERTIFICATE_FILE=
PEERONQ_ADMIN_DATA_PROTECTION_PASSWORD_FILE=
PEERONQ_SIGNALING_ATTESTATION_PRIVATE_KEY_FILE=
PEERONQ_SIGNALING_ATTESTATION_PUBLIC_KEY_FILE=
PEERONQ_BACKUP_DIR=
PEERONQ_BACKUP_RETENTION_DAYS=14
PEERONQ_RESTORE_TEST_FILE=

# Secrets: never commit populated values. Prefer runtime secret injection in managed platforms.
PEERONQ_POSTGRES_BOOTSTRAP_PASSWORD=
PEERONQ_POSTGRES_MIGRATOR_PASSWORD=
PEERONQ_CLOUD_DB_PASSWORD=
PEERONQ_PRESENCE_DB_PASSWORD=
PEERONQ_ADMIN_DB_PASSWORD=
PEERONQ_DOWNLOADS_DB_PASSWORD=
PEERONQ_POSTGRES_BACKUP_PASSWORD=
PEERONQ_POSTGRES_RESTORE_PASSWORD=
PEERONQ_REDIS_CLOUD_PASSWORD=
PEERONQ_REDIS_PRESENCE_PASSWORD=
PEERONQ_REDIS_PRESENCE_TOKEN_READER_PASSWORD=
PEERONQ_REDIS_ADMIN_PASSWORD=
PEERONQ_REDIS_DOWNLOADS_PASSWORD=
PEERONQ_REDIS_SIGNALING_PASSWORD=
PEERONQ_REDIS_HEALTH_PASSWORD=
PEERONQ_GRAFANA_ADMIN_PASSWORD_FILE=
PEERONQ_CLOUD_PUBLIC_DEVICE_ID_HMAC_KEY_BASE64=
PEERONQ_ADMIN_PRIVACY_HMAC_KEY_BASE64=
PEERONQ_DOWNLOADS_PRIVACY_HMAC_KEY_BASE64=
PEERONQ_ADMIN_TOKEN_SIGNING_KEY=
PEERONQ_CUSTOMER_TOKEN_SIGNING_KEY=
PEERONQ_CUSTOMER_REGISTRATION_MODE=Closed
PEERONQ_CUSTOMER_REQUIRE_EMAIL_VERIFICATION=false
PEERONQ_CUSTOMER_MAIL_PROVIDER=Disabled
PEERONQ_CUSTOMER_SMTP_HOST=
PEERONQ_CUSTOMER_SMTP_PORT=587
PEERONQ_CUSTOMER_SMTP_USERNAME=
PEERONQ_CUSTOMER_SMTP_PASSWORD=
PEERONQ_ADMIN_REFRESH_HASH_KEY=
PEERONQ_DOWNLOAD_COMPLETION_TOKEN_KEY=
PEERONQ_TURN_SHARED_SECRET=
PEERONQ_DIAGNOSTICS_HTTP_BEARER_TOKEN=

# Explicit one-time bootstrap. The production `.run` installer scrubs these values after creation.
PEERONQ_ADMIN_BOOTSTRAP_ENABLED=false
PEERONQ_ADMIN_BOOTSTRAP_EMAIL=
PEERONQ_ADMIN_BOOTSTRAP_PASSWORD=
PEERONQ_ADMIN_BOOTSTRAP_TOTP_SECRET_BASE32=
PEERONQ_ADMIN_BOOTSTRAP_RECOVERY_CODE_1=
PEERONQ_ADMIN_BOOTSTRAP_RECOVERY_CODE_2=
PEERONQ_ADMIN_BOOTSTRAP_RECOVERY_CODE_3=
PEERONQ_ADMIN_BOOTSTRAP_RECOVERY_CODE_4=
PEERONQ_ADMIN_BOOTSTRAP_RECOVERY_CODE_5=
PEERONQ_ADMIN_BOOTSTRAP_RECOVERY_CODE_6=
PEERONQ_ADMIN_BOOTSTRAP_RECOVERY_CODE_7=
PEERONQ_ADMIN_BOOTSTRAP_RECOVERY_CODE_8=

# Optional external diagnostics object storage service.
PEERONQ_DIAGNOSTICS_HTTP_ENDPOINT=https://diagnostics-dev.peeronq.local
PEERONQ_DIAGNOSTICS_HTTP_ALLOWED_HOST=diagnostics-dev.peeronq.local
