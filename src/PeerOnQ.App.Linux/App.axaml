<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="PeerOnQ.App.Linux.App"
             RequestedThemeVariant="Dark">
  <Application.Resources>
    <Color x:Key="PeerOnQPageColor">#111319</Color>
    <Color x:Key="PeerOnQSurfaceColor">#1A1D25</Color>
    <Color x:Key="PeerOnQSubtleColor">#232731</Color>
    <Color x:Key="PeerOnQBorderColor">#303541</Color>
    <Color x:Key="PeerOnQTextColor">#F5F7FA</Color>
    <Color x:Key="PeerOnQMutedTextColor">#98A2B3</Color>
    <Color x:Key="PeerOnQAccentColor">#36B981</Color>
    <Color x:Key="PeerOnQAccentHoverColor">#49C992</Color>
    <Color x:Key="PeerOnQAccentTextColor">#FFFFFF</Color>
    <Color x:Key="PeerOnQDangerColor">#EF6A6A</Color>
    <Color x:Key="PeerOnQRemoteCanvasColor">#000000</Color>
    <SolidColorBrush x:Key="PeerOnQPageBrush" Color="{StaticResource PeerOnQPageColor}" />
    <SolidColorBrush x:Key="PeerOnQSurfaceBrush" Color="{StaticResource PeerOnQSurfaceColor}" />
    <SolidColorBrush x:Key="PeerOnQSubtleBrush" Color="{StaticResource PeerOnQSubtleColor}" />
    <SolidColorBrush x:Key="PeerOnQBorderBrush" Color="{StaticResource PeerOnQBorderColor}" />
    <SolidColorBrush x:Key="PeerOnQTextBrush" Color="{StaticResource PeerOnQTextColor}" />
    <SolidColorBrush x:Key="PeerOnQMutedTextBrush" Color="{StaticResource PeerOnQMutedTextColor}" />
    <SolidColorBrush x:Key="PeerOnQAccentBrush" Color="{StaticResource PeerOnQAccentColor}" />
    <SolidColorBrush x:Key="PeerOnQAccentHoverBrush" Color="{StaticResource PeerOnQAccentHoverColor}" />
    <SolidColorBrush x:Key="PeerOnQAccentTextBrush" Color="{StaticResource PeerOnQAccentTextColor}" />
    <SolidColorBrush x:Key="PeerOnQDangerBrush" Color="{StaticResource PeerOnQDangerColor}" />
    <SolidColorBrush x:Key="PeerOnQRemoteCanvasBrush" Color="{StaticResource PeerOnQRemoteCanvasColor}" />
  </Application.Resources>
  <Application.Styles>
    <FluentTheme />
    <Style Selector="Window">
      <Setter Property="FontFamily" Value="system-ui, sans-serif" />
      <Setter Property="Foreground" Value="{DynamicResource PeerOnQTextBrush}" />
    </Style>
    <Style Selector="Button.primary">
      <Setter Property="Background" Value="{DynamicResource PeerOnQAccentBrush}" />
      <Setter Property="Foreground" Value="{DynamicResource PeerOnQAccentTextBrush}" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="MinHeight" Value="44" />
      <Setter Property="CornerRadius" Value="8" />
    </Style>
    <Style Selector="Button.primary:pointerover /template/ ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource PeerOnQAccentHoverBrush}" />
    </Style>
    <Style Selector="Button.secondary">
      <Setter Property="Background" Value="{DynamicResource PeerOnQSubtleBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource PeerOnQBorderBrush}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="MinHeight" Value="44" />
      <Setter Property="CornerRadius" Value="8" />
    </Style>
  </Application.Styles>
</Application>
