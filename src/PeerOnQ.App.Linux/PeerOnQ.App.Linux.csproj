<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <AssemblyName>PeerOnQ</AssemblyName>
    <RootNamespace>PeerOnQ.App.Linux</RootNamespace>
    <Version>$(PeerOnQLinuxClientVersion)</Version>
    <AssemblyVersion>$(PeerOnQLinuxClientVersion).0</AssemblyVersion>
    <FileVersion>$(PeerOnQLinuxClientVersion).0</FileVersion>
    <InformationalVersion>$(PeerOnQLinuxClientVersion)-linux-viewer-unsigned-preview</InformationalVersion>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Avalonia" />
    <PackageReference Include="Avalonia.Desktop" />
    <PackageReference Include="Avalonia.Themes.Fluent" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\PeerOnQ.Application\PeerOnQ.Application.csproj" />
    <ProjectReference Include="..\PeerOnQ.Domain\PeerOnQ.Domain.csproj" />
    <ProjectReference Include="..\PeerOnQ.Infrastructure\PeerOnQ.Infrastructure.csproj" />
    <ProjectReference Include="..\PeerOnQ.Media\PeerOnQ.Media.csproj" />
    <ProjectReference Include="..\PeerOnQ.Platform.Linux\PeerOnQ.Platform.Linux.csproj" />
    <ProjectReference Include="..\PeerOnQ.Transport\PeerOnQ.Transport.csproj" />
  </ItemGroup>
  <Target Name="ValidatePeerOnQLinuxClientVersion" BeforeTargets="PrepareForBuild">
    <Error Condition="'$(PeerOnQLinuxClientVersion)' == ''"
           Text="PeerOnQLinuxClientVersion must be defined in Directory.Build.props." />
  </Target>
</Project>
