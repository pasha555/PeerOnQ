{
  "AllowedHosts": "localhost;127.0.0.1",
  "Region": {
    "Id": "local-development"
  },
  "CloudWorkers": {
    "EnablePresenceExpiration": false,
    "EnableSessionReconciliation": true,
    "EnableRetention": true
  },
  "PeerOnQ": {
    "CustomerPortal": {
      "RegistrationMode": "Open",
      "RequireEmailVerification": true,
      "JwtIssuer": "peeronq-cloud-development",
      "JwtAudience": "peeronq-customer-portal-development",
      "JwtSigningKey": "development-only-peeronq-customer-portal-signing-key-change-me",
      "PortalBaseUrl": "https://portal.dev.localhost:8443",
      "DataProtectionPath": ".local/customer-data-protection",
      "Mail": {
        "Provider": "FileSink",
        "FromAddress": "peeronq@localhost.invalid",
        "FileSinkPath": ".local/customer-mail"
      }
    },
    "DiagnosticsStorage": {
      "Provider": "FileSystem",
      "FileSystemPath": ".local/diagnostics"
    }
  }
}
