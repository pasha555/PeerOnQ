{
  "AllowedHosts": "localhost",
  "Region": {
    "Id": "local"
  },
  "CloudWorkers": {
    "EnablePresenceExpiration": false,
    "EnableSessionReconciliation": false,
    "EnableRetention": false
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning"
      }
    }
  }
}
